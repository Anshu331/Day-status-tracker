NODE_ENV=development
PORT=4000

# Neon connection string (Dashboard -> Connect, pooled connection)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full

# at least 32 chars - `npm run setup` generates one
JWT_SECRET=replace-me-with-a-long-random-secret-of-at-least-32-chars
JWT_TTL_SECONDS=28800

# created on first start if there are no users yet
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin@12345
